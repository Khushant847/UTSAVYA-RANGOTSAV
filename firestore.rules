rules_version = '2';

// UTSAVYA RANGOTSAV Firestore Security Rules
// All data access goes through the Admin SDK (server-side actions/routes).
// Direct client-side reads/writes are denied for maximum security.

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all direct client access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow admin clients (Firebase Auth admins) to read their own admin profile
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}